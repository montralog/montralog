# Generate real values with: python scripts/setup.py
MONTRALOG_READ_TOKEN=
MONTRALOG_INGEST_TOKEN=
RETENTION_DAYS=7
# Optional external PostgreSQL; leave unset for local SQLite:
# MONTRALOG_DATABASE_URL=postgresql://user:password@host:5432/montralog?sslmode=verify-full

# New setup generates a Fernet key. Back it up separately from the database.
MONTRALOG_ENCRYPTION_KEY=
MONTRALOG_ENCRYPTION_REQUIRED=false
